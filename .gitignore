# =============================================================================
# Gitignore for Diabetic Retinopathy Deep Learning & Streamlit Project
# =============================================================================

# Large Dataset Archives & Cached Image Directories
*.zip
*.tar
*.tar.gz
*.7z
*.rar
cache_512_clahe/
cache_*/
data/
datasets/

# Deep Learning Model Weights & Checkpoints (>100MB / binary weights)
# Note: Use Git LFS or external cloud storage (Drive/HuggingFace) for weights
*.pt
*.pth
*.ckpt
*.bin
*.h5
*.onnx
*.safetensors
*.weights

# Precomputed NumPy Batch Arrays & Feature Caches
*.npy
*.npz
vqc_results_512/train_batches/
vqc_results_512/valid_batches/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# Streamlit Local Configurations & Cache
.streamlit/secrets.toml

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini

# IDE & Editor Specific Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
