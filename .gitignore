# =============================================================================
# Gitignore for Deep Learning & Streamlit Project
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Large Dataset Archives & Cached Image Directories
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.7z
*.rar
cache_512_clahe/
cache_*/
data/
datasets/

# -----------------------------------------------------------------------------
# 2. Model Weights & Checkpoints (>25MB - 100MB+ binary weights)
# -----------------------------------------------------------------------------
# Checkpoints exceed Git's recommended size (use Git LFS or Drive/HuggingFace)
*.pt
*.pth
*.ckpt
*.bin
*.h5
*.onnx
*.safetensors
*.weights

# -----------------------------------------------------------------------------
# 3. Precomputed Batch Features & Serialized Pipelines
# -----------------------------------------------------------------------------
*.npy
*.npz
*.joblib
*.pkl
*.pickle
vqc_results_512/*_batches/
vqc_results_512/train_batches/
vqc_results_512/valid_batches/
vqc_results_512/test_batches/

# -----------------------------------------------------------------------------
# 4. Old/Superseded Experiments & Smoke Tests
# -----------------------------------------------------------------------------
# Old 320x320 experiments (superseded by train_results_v2 512x512)
train_results/
*_smoke.*
*smoke*

# Redundant duplicate evaluation outputs
train_results_v2/final_test_evaluation/

# -----------------------------------------------------------------------------
# 5. Heavy Raw Dataset Label Dumps & Detailed Prediction CSVs
# -----------------------------------------------------------------------------
# Raw tabular dataset caches (>10MB in eda_outputs)
eda_outputs/ddr_*.csv
eda_outputs/quality_sample.csv

# Large per-image prediction dumps
*_predictions*.csv
train_results_v2/*_predictions*.csv
train_results_v2/final_model_package_outputs/*predictions*.csv

# -----------------------------------------------------------------------------
# 6. Python Runtime & Environment Artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# 7. Jupyter & IDE Artifacts
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb
Copy_of_*
*_copy.ipynb
.idea/
.vscode/
*.swp
*.swo

# -----------------------------------------------------------------------------
# 8. Streamlit & OS System Files
# -----------------------------------------------------------------------------
.streamlit/secrets.toml
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# Logs & Temp files
*.log
logs/
temp/
tmp/
